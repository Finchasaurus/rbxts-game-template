+local OP_UNION_NOT 		= 12 -- fail if any (R, T) pool holds the entity
+local OP_UNION_DEDUPE 	= 13 -- skip entities already yielded from earlier pools
+local OP_UNION_FETCH 	= 14 -- fragmenting column or any (R, T) DontFragment pool
+
+type queryop = {
+	kind: number,
+	on_ok: number, -- op index; -1 = yield
+	on_fail: number, -- op index; 0 = done
+	id: i53,
+	k: number, -- output position, 0 = none
+	pool: pool?,
+	pools: { pool }?,
+
+	-- Per-op archetype memo for columns_map probes which utilizes the fact that
+	-- previous archetype/column usually share an archetype so a pointer compare
+	-- replaces a check into the map.
+	pa: archetype?,
+	pc: Column?,
+}
+
+local function query_iter_df_plan(query: query): () -> (i53, ...any)
+	local world = query.world
+	local component_index = world.component_index
+	local sparse_array = world.entity_index.sparse_array
+	local ids = query.ids
+	local n_ids = #ids
+	local output = table.create(n_ids)
+	local compatible = query.compatible_archetypes
+
+	local df_union_with = query.df_union_with
+	-- The first union partitions the archetype and DontFragment drivers. All
+	-- other unions are checked against both storage kinds by the plan.
+	local id3: i53 = if df_union_with then df_union_with[1] else 0
+
+	local function record_pool(id: i53): pool?
+		local idr = component_index[id]
+		return if idr then idr.sparse else nil
+	end
+	local function union_pools_of(id: i53): { pool }
+		local arr = {}
+		local idr = component_index[id]
+		local df_pairs = if idr then idr.dont_fragment_pairs else nil
+		if df_pairs then
+			for _, idr_p in df_pairs do
+				table.insert(arr, idr_p.sparse :: pool)
+			end
+		end
+		return arr
+	end
+	-- (R, *) wildcard value resolver; such ids never appear in archetype
+	-- columns (their relation is DontFragment), so no columns_map shortcut.
+	local function plan_wc_fetch(id: i53, ent: i53): any
+		local idr = component_index[id]
+		local sparse = if idr then idr.sparse else nil
+		if not sparse then
+			return nil
+		end
+		local idx = pool_find(sparse, ent)
+		if idx == 0 then
+			return nil
+		end
+		local v = sparse.values[idx]
+		local pair_id = if sparse.exclusive then v else v[1]
+		local psparse = component_index[pair_id].sparse :: pool
+		local pidx = pool_find(psparse, ent)
+		return if pidx ~= 0 then psparse.values[pidx] else nil
+	end
+
+	local arr3: { pool }? = if id3 ~= 0 then union_pools_of(id3) else nil
+	if arr3 and #arr3 == 0 then
+		arr3 = nil
+	end
+	local union_pools: { [i53]: { pool } } = {}
+	if df_union_with then
+		for _, id in df_union_with do
+			union_pools[id] = union_pools_of(id)
+		end
+	end
+
+	-- Primary driver from the first term (no reordering): a plain
+	-- DontFragment first term pool-drives, otherwise archetypes drive.
+	-- df_only queries routed here (union withouts) pool-drive from the
+	-- first pooled term.
+	local pool2: pool?
+	local out2 = 0
+	local cov2: i53 = 0
+	do
+		local id1 = ids[1]
+		local idr1 = if id1 then component_index[id1] else nil
+		local sp1 = if idr1 then idr1.sparse else nil
+		if sp1 and not (ECS_IS_PAIR(id1) and ECS_PAIR_SECOND(id1) == EcsWildcard) then
+			pool2 = sp1
+			out2 = 1
+			cov2 = id1
+		elseif query.df_only then
+			for k = 1, n_ids do
+				local id = ids[k]
+				local sp = record_pool(id)
+				if sp then
+					pool2 = sp
+					cov2 = id
+					if not (ECS_IS_PAIR(id) and ECS_PAIR_SECOND(id) == EcsWildcard) then
+						out2 = k
+					end
+					break
+				end
+			end
+			if pool2 == nil then
+				local dfw = query.df_with :: { i53 }
+				pool2 = record_pool(dfw[1])
+				cov2 = dfw[1]
+			end
+		end
+	end
+
+	local ops: { queryop } = {}
+	local n_ops = 0
+	local function push(kind: number, id: i53, k: number, p: pool?, pools: { pool }?)
+		n_ops += 1
+		ops[n_ops] = { kind = kind, on_ok = 0, on_fail = 0, id = id, k = k, pool = p, pools = pools }
+	end
+
+	local queried: { [i53]: boolean } = {}
+	for k = 1, n_ids do
+		queried[ids[k]] = true
+	end
+
+	local function compile_block(driver_kind: number): number
+		local blk0 = n_ops + 1
+		if driver_kind == OP_ARCHETYPES then
+			push(OP_ARCHETYPES, 0, 0, nil, nil)
+		elseif driver_kind == OP_POOL then
+			push(OP_POOL, cov2, out2, pool2, nil)
+		else
+			local out3 = if queried[id3] then table.find(ids, id3) :: number else 0
+			push(OP_UNION, id3, out3, nil, arr3)
+		end
+		-- out2/cov2 describe the POOL driver only; the union block's driver
+		-- covers nothing but the union term itself, so every other term must
+		-- be checked/fetched again there.
+		local out0 = if driver_kind == OP_POOL then out2 else 0
+		local cov0 = if driver_kind == OP_POOL then cov2 else 0
+		local pool_driven = driver_kind ~= OP_ARCHETYPES
+		local resolved = false
+		local function need_resolve()
+			if pool_driven and not resolved then
+				resolved = true
+				push(OP_RESOLVE, 0, 0, nil, nil)
+			end
+		end
+		if driver_kind == OP_UNION then
+			-- NOTE(marcus): We need to deduplicate entities that carry an ID
+			-- that stores two storages simulataneosuly from a previous pool pass.
+			need_resolve()
+			push(OP_COL_NOT, id3, 0, nil, nil)
+			push(OP_UNION_DEDUPE, 0, 0, nil, arr3)
+		end
+		for k = 1, n_ids do
+			local id = ids[k]
+			if k == out0 or (driver_kind == OP_UNION and id == id3) then
+				continue
+			end
+			local union = union_pools[id]
+			local sp = record_pool(id)
+			if union then
+				need_resolve()
+				push(OP_UNION_FETCH, id, k, nil, union)
+			elseif sp then
+				if ECS_IS_PAIR(id) and ECS_PAIR_SECOND(id) == EcsWildcard then
+					if id ~= cov0 then
+						push(OP_DF_CHECK, id, 0, sp, nil)
+					end
+					push(OP_WC_FETCH, id, k, nil, nil)
+				else
+					push(OP_DF_FETCH, id, k, sp, nil)
+				end
+			else
+				need_resolve()
+				push(OP_COL_FETCH, id, k, nil, nil)
+			end
+		end
+
+		local df_with = query.df_with
+		if df_with then
+			for _, id in df_with do
+				if not queried[id] and id ~= cov0 then
+					push(OP_DF_CHECK, id, 0, record_pool(id), nil)
+				end
+			end
+		end
+
+		for _, id in query.filter_with do
+			if not queried[id] and id ~= cov0 then
+				local union = union_pools[id]
+				if union and not (driver_kind == OP_UNION and id == id3) then
+					-- The union driver already proves id3. Other unions must
+					-- match either an archetype column or DontFragment pool.
+					need_resolve()
+					push(OP_UNION_FETCH, id, 0, nil, union)
+				elseif pool_driven and not union then
+					local idr = component_index[id]
+					if not (idr and idr.sparse) then
+						need_resolve()
+						push(OP_COL_CHECK, id, 0, nil, nil)
+					end
+				end
+			end
+		end
+
+		local filter_without = query.filter_without
+		if filter_without then
+			for _, id in filter_without do
+				local idr = component_index[id]
+				local sp = if idr then idr.sparse else nil
+				if sp then
+					push(OP_DF_NOT, id, 0, sp, nil)
+				elseif idr and idr.dont_fragment_pairs then
+					if pool_driven then
+						need_resolve()
+						push(OP_COL_NOT, id, 0, nil, nil)
+					end
+					push(OP_UNION_NOT, id, 0, nil, union_pools_of(id))
+				elseif pool_driven then
+					need_resolve()
+					push(OP_COL_NOT, id, 0, nil, nil)
+				end
+			end
+		end
+		for j = blk0, n_ops do
+			ops[j].on_ok = j + 1
+			ops[j].on_fail = blk0
+		end
+		ops[n_ops].on_ok = -1
+		return blk0
+	end
+
+	local blk1 = compile_block(if pool2 then OP_POOL else OP_ARCHETYPES)
+	local blk2 = 0
+	if arr3 and not pool2 then
+		blk2 = compile_block(OP_UNION)
+		ops[blk2].on_fail = 0
+	end
+	ops[blk1].on_fail = if blk2 ~= 0 then blk2 else 0
+
+
+	local e 	= 0
+	local key 	= 0
+	local row 	= 0
+	local cm 	= NULL_ARRAY :: { [i53]: Column }
+
+	-- NOTE(marcus): we define different registers depending on the suffix.
+	--  0 - is the resolved archetype
+	--  1 - driven by archetype
+	--  2 - driven by pool
+	--  3 - driven by union
+	-- Unsuffixed registers (e/key/row/cm) hold the current row; whichever
+    -- driver is active writes into them each step.
+    -- ip/rp refers to the OP program counter and resumption points.
+
+	local arc0: archetype? 	= nil
+	local ent0: { i53 }? 	= nil
+	local row0 				= 0
+	local cur1 				= 0
+	local row1 				= 0
+	local ent1 				= NULL_ARRAY :: { i53 }
+	local cm1  				= NULL_ARRAY :: { [i53]: Column }
+	local row2 				= if pool2 then (pool2 :: pool).size else 0 -- backward dense cursor
+	local ent2 				= if pool2 then (pool2 :: pool).entities else nil
+	local val2 				= if pool2 then (pool2 :: pool).values else nil
+	local cur3 				= 0
+	local row3 				= 0
+	local ent3: buffer? 	= nil
+	local val3: { any }? 	= nil
+	local src3 				= 0
+	local rp 				= 1
+	local ip 				= 1
+
+	local function it(): any
+		while true do
+			local op = ops[ip]
+			local kind = op.kind
+			local ok: boolean
+			if kind == OP_POOL then
+				local i2 = row2
+				if i2 < 1 then
+					ok = false
+				else
+					local j2 = i2 - 1
+					row2 = j2
+					e = buffer.readf64(ent2 :: buffer, j2 * 8)
+					key = ECS_ENTITY_T_LO(e)
+					local k = op.k
+					if k ~= 0 then
+						output[k] = (val2 :: { any })[i2]
+					end
+					rp = ip
+					ok = true
+				end
+			elseif kind == OP_ARCHETYPES then
+				ok = false
+				while true do
+					if row1 > 0 then
+						e = ent1[row1]
+						key = ECS_ENTITY_T_LO(e)
+						row = row1
+						cm = cm1
+						row1 -= 1
+						rp = ip
+						ok = true
+						break
+					end
+					cur1 += 1
+					local a = compatible[cur1]
+					if a == nil then
+						break
+					end
+					ent1 = a.entities
+					row1 = #ent1
+					cm1 = a.columns_map
+					arc0 = a
+				end
+			elseif kind == OP_UNION then
+				ok = false
+				local pools = op.pools :: { pool }
+				while true do
+					local i2 = row3
+					if i2 >= 1 then
+						local j2 = i2 - 1
+						row3 = j2
+						e = buffer.readf64(ent3 :: buffer, j2 * 8)
+						key = ECS_ENTITY_T_LO(e)
+						local k = op.k
+						if k ~= 0 then
+							output[k] = (val3 :: { any })[i2]
+						end
+						src3 = cur3
+						rp = ip
+						ok = true
+						break
+					end
+					cur3 += 1
+					local p = pools[cur3]
+					if p == nil then
+						break
+					end
+					ent3 = p.entities
+					val3 = p.values
+					row3 = p.size
+				end
+			elseif kind == OP_RESOLVE then
+				-- NOTE(marcus): if the previous entity that was processed in
+				-- the resolved archetype at row N, there is a good chance that
+				-- this entity lives in the same archetype at row N-1. Because a
+				-- pool (or archetype) driver walks entities in a fairly stable
+				-- order, and entities that were created/moved around often end
+				-- up adjacent to each other in the same archetype's dense row
+				-- array too. We are making a bet on its correlation. In a case
+				-- of misprediction it just falls back to the real lookup.
+				local pr0 = row0 - 1
+				local en0 = ent0
+				if en0 ~= nil and pr0 >= 1 and en0[pr0] == e then
+					row0 = pr0
+					row = pr0
+				else
+					local r = sparse_array[key]
+					row = r.row
+					row0 = row
+					local a = r.archetype
+					if a ~= arc0 then
+						arc0 = a
+						cm = a.columns_map
+						ent0 = a.entities
+					end
+				end
+				ok = true
+			elseif kind == OP_DF_FETCH then
+				local p = op.pool :: pool
+				local idx = if key > p.map_max then 0 else buffer.readu32(p.map, key * 4)
+				if idx == 0 then
+					ok = false
+				else
+					output[op.k] = p.values[idx]
+					ok = true
+				end
+			elseif kind == OP_DF_CHECK then
+				local p = op.pool :: pool
+				ok = key <= p.map_max and buffer.readu32(p.map, key * 4) ~= 0
+			elseif kind == OP_DF_NOT then
+				local p = op.pool :: pool
+				ok = key > p.map_max or buffer.readu32(p.map, key * 4) == 0
+			elseif kind == OP_COL_FETCH then
+				if op.pa ~= arc0 then
+					op.pa = arc0
+					op.pc = cm[op.id]
+				end
+				local column = op.pc
+				if column == nil then
+					ok = false
+				else
+					output[op.k] = column[row]
+					ok = true
+				end
+			elseif kind == OP_COL_CHECK then
+				if op.pa ~= arc0 then
+					op.pa = arc0
+					op.pc = cm[op.id]
+				end
+				ok = op.pc ~= nil
+			elseif kind == OP_COL_NOT then
+				if op.pa ~= arc0 then
+					op.pa = arc0
+					op.pc = cm[op.id]
+				end
+				ok = op.pc == nil
+			elseif kind == OP_WC_FETCH then
+				output[op.k] = plan_wc_fetch(op.id, e)
+				ok = true
+			elseif kind == OP_UNION_NOT then
+				ok = true
+				for _, p in op.pools :: { pool } do
+					if key <= p.map_max and buffer.readu32(p.map, key * 4) ~= 0 then
+						ok = false
+						break
+					end
+				end
+			elseif kind == OP_UNION_FETCH then
+				if op.pa ~= arc0 then
+					op.pa = arc0
+					op.pc = cm[op.id]
+				end
+				local column = op.pc
+				if column then
+					if op.k ~= 0 then
+						output[op.k] = column[row]
+					end
+					ok = true
+				else
+					ok = false
+					for _, p in op.pools :: { pool } do
+						local idx = if key > p.map_max then 0 else buffer.readu32(p.map, key * 4)
+						if idx ~= 0 then
+							if op.k ~= 0 then
+								output[op.k] = p.values[idx]
+							end
+							ok = true
+							break
+						end
+					end
+				end
+			else -- OP_UNION_DEDUPE
+				ok = true
+				local pools = op.pools :: { pool }
+				for j = 1, src3 - 1 do
+					local p = pools[j]
+					if key <= p.map_max and buffer.readu32(p.map, key * 4) ~= 0 then
+						ok = false
+						break
+					end
+				end
+			end
+			local nxt = if ok then op.on_ok else op.on_fail
+			if nxt > 0 then
+				ip = nxt
+			elseif nxt == -1 then
+				ip = rp
+				if n_ids == 1 then
+					return e, output[1]
+				elseif n_ids == 2 then
+					return e, output[1], output[2]
+				elseif n_ids == 3 then
+					return e, output[1], output[2], output[3]
+				elseif n_ids == 4 then
+					return e, output[1], output[2], output[3], output[4]
+				end
+				return e, unpack(output, 1, n_ids)
+			else
+				ip = rp
+				return nil
+			end
+		end
+	end
+	query.next = it
+	return it
+end
+
+local function query_iter_df_init(query: query): () -> (i53, ...any)
+	local world = query.world
+	local component_index = world.component_index
+	local ids = query.ids
+	local n_ids = #ids
+
+	-- (*, T) union terms always take the compiled plan (two blocks).
+	if query.df_union_with ~= nil or query.df_union_without ~= nil then
+		return query_iter_df_plan(query)
+	end
+
+	local df_with = query.df_with :: { i53 }
+	local df_without = query.df_without
+
+	-- NOTE(marcsu): This is a slower resolver of values for (R, &) DF terms.
+	-- The only id kind whose value cannot come from a pool probe because the
+	-- wildcard pool holds target bookeeping.
+	local function fetch_value(id: i53, e: i53): any
+		-- NOTE(marcus): The query terms are ensured at derive as due to our
+		-- work to mitigate edge cases at uncached queries.
+		local sparse = component_index[id].sparse :: pool
+		local idx = pool_find(sparse, e)
+		local v = sparse.values[idx]
+		if ECS_IS_PAIR(id) and ECS_PAIR_SECOND(id) == EcsWildcard then
+			local pair_id = if sparse.exclusive then v else v[1]
+			local psparse = component_index[pair_id].sparse :: pool
+			local pidx = pool_find(psparse, e)
+			v = if pidx ~= 0 then psparse.values[pidx] else nil
+		end
+		return v
+	end
+
+	local output = table.create(n_ids)
+
+	-- NOTE(marcus): We want to avoid re-checking every row. In order to do this
+	-- we must decide how to fetch each id once, at plan time. Because a plain
+	-- DontFragment id's pool proves presence, thereby the same read hands
+	-- back the dense value index for free without a second pass for membership,
+	-- and valueless entries just come back as nil. (R, *) pairs are a bit more
+	-- complicated as they have no pool of their own to probe because the
+	-- DontFragment flag lives in the relation record, not the wildcard one so
+	-- those have to fall to the slow resolver. Everything else is considered a
+	-- regular ID, i.e. corresponds to a standard archetype column.
+	local plan_pool 	= {} :: { [number]: pool }
+	local planned  		= {} :: { [i53]: boolean }
+	-- `k` stands for the position of the term in the query's parameters list.
+	local df_ks 		= {} :: { number } -- queried plain DontFragment ids (fused check+fetch)
+	local wc_ks 		= {} :: { number } -- queried (R, *) DontFragment wildcards (slow resolver)
+	local col_ks		= {} :: { number } -- fragmenting ids (column fetch)
+	local n_df_ks 		= 0
+	local n_wc_ks 		= 0
+	local n_col_ks 		= 0
+
+	for k = 1, n_ids do
+		local id = ids[k]
+		local idr = component_index[id]
+		local sp = idr and idr.sparse
+		if sp then
+			if ECS_IS_PAIR(id) and ECS_PAIR_SECOND(id) == EcsWildcard then
+				n_wc_ks += 1
+				wc_ks[n_wc_ks] = k
+			else
+				n_df_ks += 1
+				df_ks[n_df_ks] = k
+				plan_pool[k] = sp
+				planned[id] = true
+			end
+		else
+			n_col_ks += 1
+			col_ks[n_col_ks] = k
+		end
+	end
+
+	-- Presence-only checks: DontFragment with-terms whose value the plan
+	-- above does not already fetch (wildcards and non-queried withs).
+	local check_pools: { pool }?
+	if df_with then
+		local arr = {}
+		local n_arr = 0
+		for _, id in df_with do
+			if not planned[id] then
+				local idr_c = component_index[id]
+				if not idr_c then
+					return NOOP :: any
+				end
+				n_arr += 1
+				arr[n_arr] = idr_c.sparse :: pool
+			end
+		end
+		if n_arr > 0 then
+			check_pools = arr
+		end
+	end
+	local without_pools: { pool }?
+	if df_without then
+		local arr = {}
+		local n_arr = 0
+		for _, id in df_without do
+			local idr_c = component_index[id]
+			if idr_c then
+				n_arr += 1
+				arr[n_arr] = idr_c.sparse :: pool
+			end
+		end
+		if n_arr > 0 then
+			without_pools = arr
+		end
+	end
+
+	local has_wcs = n_wc_ks > 0
+	local single_df_k: number = if n_df_ks == 1 then df_ks[1] else 0
+	local single_df_pool: pool? = if n_df_ks == 1 then plan_pool[df_ks[1]] else nil
+	local single_check: pool? = if check_pools and #check_pools == 1
+		then check_pools[1]
+		else nil
+	local single_without: pool? = if without_pools and #without_pools == 1
+		then without_pools[1]
+		else nil
+
+	local sdf_map: buffer, sdf_max: number, sdf_values: { any }
+	if single_df_pool then
+		sdf_map = single_df_pool.map
+		sdf_max = single_df_pool.map_max
+		sdf_values = single_df_pool.values
+	end
+	local sc_map: buffer, sc_max: number
+	if single_check then
+		sc_map = single_check.map
+		sc_max = single_check.map_max
+	end
+	local swo_map: buffer, swo_max: number
+	if single_without then
+		swo_map = single_without.map
+		swo_max = single_without.map_max
+	end
