{
	"name": "rbxts-game-template",
	"sourcePaths": ["src"],
	"routes": {
		"shared": "ReplicatedStorage/shared",
		"client": "ReplicatedStorage/client",
		"app": "ReplicatedStorage/app",
		"boot": "ReplicatedFirst",
		"server": "ServerScriptService/server"
		// "*": "ReplicatedStorage/shared"
	},
	"compiledPath": "out",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@rbxts-js": {
						"$path": "node_modules/@rbxts-js"
					},
					"@flamework": {
						"$path": "node_modules/@flamework"
					},
					"@kyrorblx": {
						"$path": "node_modules/@kyrorblx"
					}
				}
			},
			"$path": "roblox"
		},
		"ReplicatedFirst": {
			"$className": "ReplicatedFirst"
		},
		"ServerScriptService": {
			"$className": "ServerScriptService"
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"$properties": {
				"EnableMouseLockOption": false
			}
		},
		"StarterGui": {
			"$className": "StarterGui",
			"$properties": {
				"ScreenOrientation": "LandscapeSensor"
			}
		}
	},
	"emitLegacyScripts": false,
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json"]
}
